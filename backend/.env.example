# Copiar a .env (cp .env.example .env) y completar. El archivo .env NO se versiona.
# Las claves viven solo aquí: nunca se envían al frontend ni se escriben en el código.

# --- Aplicación -----------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma (formato JSON)
INVERAI_ORIGENES_CORS=["http://localhost:4200"]

# --- OpenAI ---------------------------------------------------------------------
# Sin esta clave el asistente funciona en modo demostración (responde con un saludo).
OPENAI_API_KEY=
# Modelo a usar; ajústalo al que corresponda a tu cuenta/agente.
OPENAI_MODEL=gpt-5.6-terra

# --- AlphaVantage ---------------------------------------------------------------
# Datos de mercado y de compañías. El plan gratuito tiene una cuota baja de llamadas.
ALPHAVANTAGE_API_KEY=
# Segundos que se cachean las respuestas de AlphaVantage para ahorrar cuota
INVERAI_ALPHAVANTAGE_CACHE_TTL=900
